# Source this from start-belemaApi.sh (or set as systemd Environment=).
# Spring Boot maps APP_MAX_ADMINS -> app.max-admins. Not editable from the app UI.
# Smoke marker: keep in sync with server env/belema-api.env toggles.
export APP_MAX_ADMINS=2

# Force temp-password change on create / block APIs until changed. Set false to disable.
export APP_REQUIRE_PASSWORD_CHANGE=true

# Force 2FA setup for any user without it / block APIs until enabled. Set false to disable.
export APP_REQUIRE_2FA=true
